# Git LFS policy (threshold and rationale in docs/RUNBOOK.md)
# compiled paper
paper/paper.pdf filter=lfs diff=lfs merge=lfs -text
# model checkpoints
*.pt filter=lfs diff=lfs merge=lfs -text
*.ckpt filter=lfs diff=lfs merge=lfs -text
# generated-unit archives, if committed at all
data/generated/**/*.npz filter=lfs diff=lfs merge=lfs -text
results/**/*.npz filter=lfs diff=lfs merge=lfs -text
# figure bundles under artifacts/
artifacts/**/*.png filter=lfs diff=lfs merge=lfs -text
artifacts/**/*.pdf filter=lfs diff=lfs merge=lfs -text
