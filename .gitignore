# datasets are never committed (R10); fetch script + checksums reproduce them
/data/
# (data/raw, data/processed, data/generated, data/work are all ignored)
data/processed/
data/generated/
workspace/
# model checkpoints are LFS-tracked only under checkpoints/ (see RUNBOOK); scratch ones ignored
*.ckpt.tmp
runs_scratch/
# caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/
*.egg-info/
.cache/
# latex build products (compiled PDF is committed via LFS)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz

# local toolchain (tectonic etc.), fetched by scripts/s0_setup_env.sh
.tools/

paper/paper_clean.pdf
paper/*.stdout
